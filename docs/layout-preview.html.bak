<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>新布局视觉稿（本地播放版）- 小风音乐</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  html, body {
    width: 100%; height: 100%;
    overflow: hidden;
    font-family: "Microsoft YaHei", "PingFang SC", "Segoe UI", system-ui, sans-serif;
    color: #ffffff;
    background: #0b0b16;
    user-select: none;
    -webkit-user-select: none;
  }

  /* ===== 背景层：深色氛围渐变 ===== */
  .bg {
    position: fixed; inset: 0; z-index: 0;
    background:
      radial-gradient(1100px 700px at 78% 20%, rgba(72, 62, 130, 0.55), transparent 60%),
      radial-gradient(900px 620px at 15% 85%, rgba(42, 80, 120, 0.45), transparent 60%),
      linear-gradient(160deg, #12121f 0%, #0b0b16 55%, #07070d 100%);
    transition: background 0.8s;
  }
  .bg::after {
    content: ""; position: absolute; inset: 0;
    background: radial-gradient(600px 300px at 20% 8%, rgba(255,255,255,0.06), transparent 70%);
  }
  /* 播放时背景跟随当前封面配色（淡色氛围，保持白字可读） */
  .bg.has-cover {
    background:
      radial-gradient(1100px 700px at 78% 20%, rgba(90, 90, 150, 0.5), transparent 60%),
      radial-gradient(900px 620px at 15% 85%, rgba(60, 80, 130, 0.4), transparent 60%),
      linear-gradient(160deg, #14141f 0%, #0d0d16 55%, #08080d 100%);
  }

  /* ===== 顶部居中：在线播放（搜索）入口 ===== */
  .online-search {
    position: fixed;
    top: 7vh;
    left: 50%;
    transform: translateX(-50%);
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 12px;
    width: 380px;
    max-width: 60vw;
    padding: 12px 20px;
    border-radius: 999px;
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.22);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 8px 28px rgba(0,0,0,0.3);
    transition: border-color 0.2s, background 0.2s;
  }
  .online-search:focus-within {
    border-color: rgba(255,255,255,0.55);
    background: rgba(255,255,255,0.1);
  }
  .online-search .search-icon { flex-shrink: 0; color: rgba(255,255,255,0.85); display: flex; }
  .online-search input {
    flex: 1; min-width: 0;
    background: none; border: none; outline: none;
    color: #fff; font-size: 15px; font-family: inherit; letter-spacing: 1px;
  }
  .online-search input::placeholder { color: rgba(255,255,255,0.45); }
  .online-search .search-hint {
    flex-shrink: 0; font-size: 12px; letter-spacing: 2px;
    color: rgba(255,255,255,0.5);
    border-left: 1px solid rgba(255,255,255,0.18); padding-left: 12px;
    cursor: pointer;
  }
  .online-search .search-hint:hover { color: #fff; }

  /* ===== 左上角文字区（宽度限制在左半区，不与顶部居中的搜索框冲突）===== */
  .header { position: fixed; top: 9vh; left: 6.5vw; z-index: 10; max-width: 34vw; }
  .main-title {
    font-size: 76px; font-weight: 700; letter-spacing: 4px;
    line-height: 1.1; text-align: left;
    text-shadow: 0 2px 24px rgba(0,0,0,0.45);
    max-width: 100%;
    white-space: nowrap; overflow: hidden;
  }
  .sub-title {
    margin-top: 14px;
    font-size: 38px; font-weight: 300; letter-spacing: 8px;
    text-align: center; color: rgba(255,255,255,0.92);
    text-shadow: 0 1px 16px rgba(0,0,0,0.4);
    max-width: 100%;
    white-space: nowrap; overflow: hidden;
  }
  /* 歌名/歌手同行滚动（跑马灯）：仅超长时启动，由 JS 设置 --scroll-dist 与 --scroll-dur */
  .marquee-inner {
    display: inline-block;
    white-space: nowrap;
    padding-right: 80px;   /* 滚动到末尾后留出间隔再循环 */
    will-change: transform;
    animation: marquee var(--scroll-dur, 0s) linear infinite;
    animation-play-state: running;
  }
  .marquee-inner.static {
    padding-right: 0;
    animation: none;
  }
  @keyframes marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(var(--scroll-dist, -100px)); }
  }
  .sub-title::before { content: "—"; margin-right: 18px; color: rgba(255,255,255,0.6); font-weight: 200; }
  .sub-title::after  { content: "—"; margin-left: 18px;  color: rgba(255,255,255,0.6); font-weight: 200; }

  /* ===== 左侧播放控件 ===== */
  .player {
    position: fixed; left: 6.5vw; top: 50%; transform: translateY(-50%);
    z-index: 10; display: flex; flex-direction: column; align-items: center; gap: 26px;
  }
  .cover {
    width: 268px; height: 268px; border-radius: 30px;
    background: linear-gradient(150deg, #3d3a5c 0%, #23233a 55%, #151527 100%);
    box-shadow: 0 24px 60px rgba(0,0,0,0.5), inset 0 0 0 1px rgba(255,255,255,0.08);
    display: flex; align-items: center; justify-content: center;
    overflow: hidden; position: relative;
  }
  #cover-img {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; opacity: 0; transition: opacity 0.5s;
  }
  #cover-img.show { opacity: 1; }
  .cover-note { position: relative; z-index: 2; width: 74px; height: 74px; opacity: 0.85; transition: opacity 0.4s; }
  .cover.has-cover .cover-note { opacity: 0; }

  .controls { width: 268px; display: flex; flex-direction: column; gap: 16px; }

  .progress { width: 100%; height: 14px; display: flex; align-items: center; cursor: pointer; }
  .progress-track { position: relative; width: 100%; height: 2px; border-radius: 1px; background: rgba(255,255,255,0.22); }
  .progress-fill {
    position: absolute; left: 0; top: 0; height: 100%; width: 0%;
    border-radius: 1px; background: #fff; box-shadow: 0 0 8px rgba(255,255,255,0.6);
  }
  .progress-dot {
    position: absolute; top: 50%; left: 0%;
    width: 9px; height: 9px; border-radius: 50%;
    background: #fff; transform: translate(-50%, -50%);
    box-shadow: 0 0 10px rgba(255,255,255,0.9);
  }
  /* 时间显示 */
  .time-row { display: flex; justify-content: space-between; font-size: 11px; color: rgba(255,255,255,0.5); font-variant-numeric: tabular-nums; margin-top: -6px; }

  .btn-row { display: flex; align-items: center; justify-content: space-between; width: 100%; }
  .icon-btn {
    background: none; border: none; color: rgba(255,255,255,0.92); cursor: pointer;
    padding: 6px; display: flex; align-items: center; justify-content: center;
    transition: transform 0.15s, color 0.15s, opacity 0.15s;
  }
  .icon-btn:hover { color: #fff; transform: scale(1.12); }
  .icon-btn:active { transform: scale(0.94); }
  .icon-btn svg { display: block; }
  .icon-btn.play { transform: scale(1.18); }
  .icon-btn.play:hover { transform: scale(1.3); }
  .icon-btn.play:active { transform: scale(1.1); }
  .icon-btn.secondary { opacity: 0.82; }

  /* ===== 更多选项：弹出功能菜单 ===== */
  .more-menu {
    position: fixed;
    left: calc(6.5vw + 268px - 208px);
    top: 50%; transform: translateY(-50%);
    z-index: 30; min-width: 196px;
    background: rgba(18,18,32,0.88);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,0.12); border-radius: 16px;
    box-shadow: 0 16px 44px rgba(0,0,0,0.55);
    padding: 8px;
    opacity: 0; pointer-events: none;
    transition: opacity 0.18s ease;
  }
  .more-menu.open { opacity: 1; pointer-events: auto; }
  .menu-item {
    display: flex; align-items: center; gap: 12px;
    padding: 11px 14px; font-size: 14px;
    color: rgba(255,255,255,0.92); border-radius: 10px; cursor: pointer;
    transition: background 0.14s, color 0.14s;
  }
  .menu-item:hover { background: rgba(255,255,255,0.12); color: #fff; }
  .menu-item span { letter-spacing: 1px; }
  .menu-divider { height: 1px; margin: 6px 10px; background: rgba(255,255,255,0.1); }
  /* 播放列表面板 */
  .playlist-panel {
    position: fixed; left: calc(6.5vw + 268px + 18px); top: 50%; transform: translateY(-50%);
    z-index: 30; width: 300px; max-height: 50vh;
    background: rgba(18,18,32,0.9);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,0.12); border-radius: 16px;
    box-shadow: 0 16px 44px rgba(0,0,0,0.55);
    padding: 10px; overflow-y: auto;
    opacity: 0; pointer-events: none;
    transition: opacity 0.18s ease;
  }
  .playlist-panel.open { opacity: 1; pointer-events: auto; }
  .playlist-panel::-webkit-scrollbar { width: 4px; }
  .playlist-panel::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.15); border-radius: 2px; }
  .pl-title { font-size: 13px; letter-spacing: 2px; color: rgba(255,255,255,0.6); padding: 6px 10px 10px; }
  .pl-item {
    display: flex; align-items: center; gap: 10px;
    padding: 9px 10px; border-radius: 10px; cursor: pointer;
    transition: background 0.14s;
  }
  .pl-item:hover { background: rgba(255,255,255,0.08); }
  .pl-item.active { background: rgba(255,255,255,0.14); }
  .pl-item .pl-idx { width: 22px; font-size: 11px; color: rgba(255,255,255,0.4); flex-shrink: 0; text-align: right; }
  .pl-item .pl-name { flex: 1; min-width: 0; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pl-item .pl-artist { font-size: 11px; color: rgba(255,255,255,0.45); max-width: 90px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pl-empty { padding: 20px; text-align: center; font-size: 13px; color: rgba(255,255,255,0.4); }

  /* ===== 右侧歌词区：右侧垂直居中，歌词水平居中（完整显示，自动换行不截断）===== */
  .lyrics {
    position: fixed; right: 7vw; top: 50%; transform: translateY(-50%);
    z-index: 10;
    display: flex; flex-direction: column; align-items: center; gap: 16px;
    width: 44vw; text-align: center;
  }
  .lyric-line {
    font-size: 26px; font-weight: 500; color: rgba(255,255,255,0.35);
    letter-spacing: 2px; text-shadow: 0 1px 12px rgba(0,0,0,0.4);
    width: 100%;
    /* 长歌词自动换行，不省略截断 */
    white-space: normal;
    word-break: break-word;
    line-height: 1.5;
    transition: color 0.4s, font-size 0.4s, opacity 0.4s;
  }
  .lyric-line.prev, .lyric-line.next { opacity: 0.65; }
  .lyric-line.current { font-size: 36px; font-weight: 700; text-shadow: 0 2px 20px rgba(0,0,0,0.55); }
  .lyric-line.current .hl { color: #ffd76a; }
  /* 卡拉OK整行扫光：已播部分纯白+辉光，未播部分半透明白（--scan-p 由 JS 每帧更新） */
  .lyric-line.current .lyric-main {
    background: linear-gradient(
      to right,
      #ffffff var(--scan-p, 0%),
      rgba(255,255,255,0.32) var(--scan-p, 0%)
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-shadow: none; /* text-shadow 破坏渐变，辉光改用 drop-shadow */
    filter: drop-shadow(0 0 12px rgba(255,255,255,0.55));
    transition: none;
  }
  /* 歌词翻译：原文下方，小一号半透明（不参与扫光） */
  .lyric-trans {
    display: block;
    margin-top: 6px;
    font-size: 17px;
    font-weight: 400;
    letter-spacing: 1px;
    color: rgba(255,255,255,0.55);
    line-height: 1.5;
  }
  .lyric-line.current .lyric-trans { color: rgba(255,255,255,0.62); font-size: 19px; }
  .lyric-placeholder { font-size: 26px; font-weight: 500; color: rgba(255,255,255,0.3); letter-spacing: 3px; font-style: italic; }

  /* ===== 底部居中：励志句子（自动轮换，上移避开频谱条）===== */
  .motivation {
    position: fixed; left: 50%; bottom: 20vh; transform: translateX(-50%);
    z-index: 10; width: max-content; max-width: 86vw;
    text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    font-size: 24px; font-weight: 300; letter-spacing: 4px;
    color: rgba(255,255,255,0.75); text-shadow: 0 2px 16px rgba(0,0,0,0.5);
    transition: opacity 0.6s ease;
  }
  .motivation.fade { opacity: 0; }

  /* ===== 底部频谱条：白色半透明柱形，随音乐律动 ===== */
  .eq {
    position: fixed;
    left: 0; right: 0; bottom: 0;
    height: 110px;
    z-index: 5;
    pointer-events: none;
  }
  .eq canvas {
    width: 100%; height: 100%;
    display: block;
  }

  /* 简单反馈提示 */
  #feedback-tip {
    position: fixed; left: 50%; top: 50%; transform: translate(-50%, -50%);
    z-index: 99; padding: 14px 26px; border-radius: 12px;
    background: rgba(18,18,32,0.92); border: 1px solid rgba(255,255,255,0.15);
    color: #fff; font-size: 15px; letter-spacing: 1px;
    box-shadow: 0 12px 36px rgba(0,0,0,0.5);
    opacity: 0; transition: opacity 0.2s; pointer-events: none;
  }

  @media (max-width: 900px) {
    .main-title { font-size: 52px; }
    .sub-title { font-size: 26px; }
    .cover { width: 220px; height: 220px; border-radius: 26px; }
    .controls { width: 220px; }
    .player { gap: 20px; }
    .lyric-line { font-size: 22px; }
    .lyric-line.current { font-size: 30px; }
    .lyrics { width: 36vw; }
    .motivation { font-size: 20px; }
  }
</style>
</head>
<body>

<div class="bg" id="bg"></div>

<!-- 0. 顶部居中：在线播放（搜索）入口 -->
<div class="online-search">
  <span class="search-icon">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="7"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
  </span>
  <input type="text" placeholder="搜索歌曲，在线播放..." spellcheck="false" id="search-input">
  <span class="search-hint" id="search-hint">在线播放</span>
</div>

<!-- 1. 左上角文字区 -->
<div class="header">
  <div class="main-title" id="main-title">小风音乐</div>
  <div class="sub-title" id="sub-title">此刻聆听</div>
</div>

<!-- 2. 左侧播放控件 -->
<div class="player">
  <div class="cover" id="cover">
    <img id="cover-img" alt="">
    <svg class="cover-note" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
      <path d="M9 18V5l12-2v13"></path>
      <circle cx="6" cy="18" r="3"></circle>
      <circle cx="18" cy="16" r="3"></circle>
    </svg>
  </div>

  <input type="file" id="folder-input" webkitdirectory multiple style="display:none">

  <div class="controls">
    <div class="progress" id="progress">
      <div class="progress-track">
        <div class="progress-fill" id="progress-fill"></div>
        <div class="progress-dot" id="progress-dot"></div>
      </div>
    </div>
    <div class="time-row">
      <span id="time-current">0:00</span>
      <span id="time-total">0:00</span>
    </div>

    <div class="btn-row">
      <button class="icon-btn secondary" id="btn-mode" title="播放模式：列表循环">
        <svg id="mode-repeat" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="17 1 21 5 17 9"></polyline>
          <path d="M3 11V9a4 4 0 0 1 4-4h14"></path>
          <polyline points="7 23 3 19 7 15"></polyline>
          <path d="M21 13v2a4 4 0 0 1-4 4H3"></path>
        </svg>
        <svg id="mode-shuffle" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display:none">
          <polyline points="16 3 21 3 21 8"></polyline>
          <line x1="4" y1="20" x2="21" y2="3"></line>
          <polyline points="21 16 21 21 16 21"></polyline>
          <line x1="15" y1="15" x2="21" y2="21"></line>
          <line x1="4" y1="4" x2="9" y2="9"></line>
        </svg>
        <svg id="mode-repeat-one" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display:none">
          <polyline points="17 1 21 5 17 9"></polyline>
          <path d="M3 11V9a4 4 0 0 1 4-4h14"></path>
          <polyline points="7 23 3 19 7 15"></polyline>
          <path d="M21 13v2a4 4 0 0 1-4 4H3"></path>
          <line x1="11" y1="10" x2="12" y2="14"></line>
          <line x1="9" y1="13" x2="13" y2="13"></line>
        </svg>
      </button>
      <button class="icon-btn secondary" id="btn-prev" title="上一曲">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="19 20 9 12 19 4 19 20" fill="currentColor" stroke="none"></polygon>
          <line x1="5" y1="4" x2="5" y2="20"></line>
        </svg>
      </button>
      <button class="icon-btn play" id="btn-play" title="播放/暂停">
        <svg id="icon-play" width="30" height="30" viewBox="0 0 24 24" fill="currentColor" stroke="none">
          <path d="M8 5v14l11-7z"></path>
        </svg>
        <svg id="icon-pause" width="30" height="30" viewBox="0 0 24 24" fill="currentColor" stroke="none" style="display:none">
          <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"></path>
        </svg>
      </button>
      <button class="icon-btn secondary" id="btn-next" title="下一曲">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="5 4 15 12 5 20 5 4" fill="currentColor" stroke="none"></polygon>
          <line x1="19" y1="4" x2="19" y2="20"></line>
        </svg>
      </button>
      <button class="icon-btn secondary" id="btn-more" title="更多选项">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="5" r="1.6" fill="currentColor" stroke="none"></circle>
          <circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none"></circle>
          <circle cx="12" cy="19" r="1.6" fill="currentColor" stroke="none"></circle>
        </svg>
      </button>
    </div>
  </div>
</div>

<!-- 更多选项：弹出功能菜单 -->
<div class="more-menu" id="more-menu">
  <div class="menu-item" data-action="选择文件夹" id="menu-pick-folder"><span>选择音乐文件夹</span></div>
  <div class="menu-item" data-action="播放列表" id="menu-playlist">📃 <span>播放列表</span></div>
  <div class="menu-item" data-action="下载歌曲">⬇️ <span>下载歌曲</span></div>
  <div class="menu-divider"></div>
  <div class="menu-item" data-action="设置">⚙️ <span>设置</span></div>
</div>

<!-- 播放列表面板 -->
<div class="playlist-panel" id="playlist-panel">
  <div class="pl-title">本地音乐 · <span id="pl-count">0</span> 首</div>
  <div id="pl-list"></div>
</div>

<!-- 3. 右侧歌词区 -->
<div class="lyrics" id="lyrics">
  <div class="lyric-line prev" id="lrc-prev"></div>
  <div class="lyric-line current" id="lrc-current">选择音乐文件夹开始播放</div>
  <div class="lyric-line next" id="lrc-next"></div>
</div>
<!-- 4. 底部居中：励志句子 -->
<div class="motivation" id="motivation">把平凡的日子，过成滚烫的诗</div>

<!-- 5. 底部频谱条：白色半透明柱形，随音乐律动 -->
<div class="eq">
  <canvas id="eq-canvas"></canvas>
</div>

<div id="feedback-tip"></div>

<script>
(function () {
  "use strict";
  // ============ DOM ============
  const $ = (id) => document.getElementById(id);
  const cover = $("cover");
  const coverImg = $("cover-img");
  const mainTitle = $("main-title");
  const subTitle = $("sub-title");
  const menuPickFolder = $("menu-pick-folder");
  const folderInput = $("folder-input");
  const btnPlay = $("btn-play");
  const iconPlay = $("icon-play");
  const iconPause = $("icon-pause");
  const btnPrev = $("btn-prev");
  const btnNext = $("btn-next");
  const btnMode = $("btn-mode");
  const btnMore = $("btn-more");
  const moreMenu = $("more-menu");
  const progressEl = $("progress");
  const progressFill = $("progress-fill");
  const progressDot = $("progress-dot");
  const timeCurrent = $("time-current");
  const timeTotal = $("time-total");
  const lrcPrev = $("lrc-prev");
  const lrcCurrent = $("lrc-current");
  const lrcNext = $("lrc-next");
  const playlistPanel = $("playlist-panel");
  const plList = $("pl-list");
  const plCount = $("pl-count");
  const bg = $("bg");

  // ============ 播放器状态 ============
  const audio = new Audio();
  let songs = [];            // { file, name, artist, url, cover, lrc }
  let currentIdx = -1;
  let playing = false;
  let modeIdx = 0;           // 0=列表循环 1=随机 2=单曲
  const modeOrder = ["repeat", "shuffle", "repeatOne"];
  const modeNames = { repeat: "列表循环", shuffle: "随机播放", repeatOne: "单曲循环" };
  const modeIcons = {
    repeat: $("mode-repeat"), shuffle: $("mode-shuffle"), repeatOne: $("mode-repeat-one"),
  };

  // ============ 目录选择（菜单项触发；加载后变为"重新选择文件夹"）============
  function openFolderPicker() {
    // 清空 value，保证连续选择同一文件夹也触发 change
    folderInput.value = "";
    folderInput.click();
  }
  menuPickFolder.addEventListener("click", (e) => {
    e.stopPropagation();
    moreMenu.classList.remove("open");
    openFolderPicker();
  });
  folderInput.addEventListener("change", async (e) => {
    const files = Array.from(e.target.files || []);
    if (!files.length) return;
    await loadFolder(files);
  });

  async function loadFolder(files) {
    // 按 webkitRelativePath 建立目录索引
    const byDir = {};
    const audioFiles = [];
    for (const f of files) {
      const rel = f.webkitRelativePath || f.name;
      const parts = rel.split("/");
      const dir = parts.slice(0, -1).join("/");
      const name = parts[parts.length - 1];
      if (!byDir[dir]) byDir[dir] = { imgs: [], lrcs: [], audios: [] };
      const ext = (name.match(/\.([^.]+)$/) || [])[1] || "";
      if (["jpg","jpeg","png","webp","bmp"].includes(ext.toLowerCase())) byDir[dir].imgs.push({ name, file: f });
      else if (ext.toLowerCase() === "lrc") byDir[dir].lrcs.push({ name, file: f });
      else if (["mp3","flac","wav","ogg","m4a","aac","wma","opus"].includes(ext.toLowerCase())) {
        byDir[dir].audios.push({ name, file: f });
        audioFiles.push(f);
      }
    }

    // 解析每个音频：标签(标题/歌手/内嵌封面) + 同目录封面/歌词
    const loaded = [];
    for (const f of audioFiles) {
      const rel = f.webkitRelativePath || f.name;
      const parts = rel.split("/");
      const dir = parts.slice(0, -1).join("/");
      const name = parts[parts.length - 1];
      const base = name.replace(/\.[^.]+$/, "");
      const bucket = byDir[dir] || { imgs: [], lrcs: [] };

      let tag = { title: "", artist: "", cover: null };
      try {
        const buf = new Uint8Array(await f.arrayBuffer());
        tag = parseAudioTags(buf);
      } catch (err) { /* 解析失败忽略 */ }

      // ⚠️ 文件名兜底解析：`歌手 - 歌名`（空格-空格分隔，按第一个 " - " 拆）
      //    内嵌标签缺失/无歌手时用（如 M4A 容器伪 .mp3 无 ID3 标签）
      const nameParts = parseFileName(base);

      // 同目录封面：同名 > cover/folder/album/front/artwork > 第一张图
      let coverUrl = null;
      if (!tag.cover) {
        const imgCandidates = [
          ...bucket.imgs.filter((i) => i.name.replace(/\.[^.]+$/, "").toLowerCase() === base.toLowerCase()),
          ...bucket.imgs.filter((i) => ["cover","folder","album","front","artwork","albumart"].includes(i.name.replace(/\.[^.]+$/, "").toLowerCase())),
          ...bucket.imgs,
        ];
        if (imgCandidates.length) coverUrl = URL.createObjectURL(imgCandidates[0].file);
      } else {
        coverUrl = URL.createObjectURL(new Blob([tag.cover], { type: "image/jpeg" }));
      }

      // 同目录歌词：同名 .lrc
      let lrcText = null;
      const lrcFile = bucket.lrcs.find((l) => l.name.replace(/\.[^.]+$/, "").toLowerCase() === base.toLowerCase())
        || bucket.lrcs[0];
      if (lrcFile) lrcText = await lrcFile.file.text();

      loaded.push({
        file: f,
        name: tag.title || nameParts.title || base,
        artist: tag.artist || nameParts.artist || "未知歌手",
        url: URL.createObjectURL(f),
        cover: coverUrl,
        lrc: lrcText,
      });
    }
    songs = loaded;
    plCount.textContent = songs.length;
    renderPlaylist();
    // 已选择文件夹 → 菜单项变为"重新选择文件夹"
    const pickLabel = menuPickFolder.querySelector("span");
    if (pickLabel) pickLabel.textContent = "重新选择文件夹";
    menuPickFolder.dataset.action = "重新选择文件夹";
    showFeedback("已加载 " + songs.length + " 首本地音乐");
    if (songs.length) playAt(0);
  }

  // ============ 音频标签解析（ID3v2 / FLAC）============
  // 文件名兜底：`歌手 - 歌名`（按第一个 " - " 拆分，前后 trim）
  // 例：`cici_ - 把回忆拼好给你` → { artist: "cici_", title: "把回忆拼好给你" }
  function parseFileName(base) {
    const idx = base.indexOf(" - ");
    if (idx > 0) {
      const artist = base.slice(0, idx).trim();
      const title = base.slice(idx + 3).trim();
      if (artist && title) return { artist, title };
    }
    return { artist: "", title: base.trim() };
  }

  function parseAudioTags(buf) {
    const out = { title: "", artist: "", cover: null };
    const isMp3 = buf[0] === 0x49 && buf[1] === 0x44 && buf[2] === 0x33; // "ID3"
    const isFlac = buf[0] === 0x66 && buf[1] === 0x4c && buf[2] === 0x61 && buf[3] === 0x43; // "fLaC"

    if (isMp3) parseId3(buf, out);
    else if (isFlac) parseFlac(buf, out);
    return out;
  }

  // ID3v2 解析（支持 v2.3/v2.4，帧 ID：TIT2 标题、TPE1 歌手、APIC 封面）
  function parseId3(buf, out) {
    if (buf.length < 10) return;
    const ver = buf[3];
    let size = readSyncsafe(buf, 6, 4);
    let off = 10;
    const end = Math.min(buf.length, 10 + size);

    if (ver === 2) {
      // ID3v2.2：3 字节帧 ID
      while (off + 6 <= end) {
        const id = String.fromCharCode(buf[off], buf[off + 1], buf[off + 2]);
        const sz = (buf[off + 3] << 16) | (buf[off + 4] << 8) | buf[off + 5];
        const d = off + 6;
        if (sz <= 0 || d + sz > buf.length) break;
        if (id === "TT2") out.title = decodeText(buf, d, sz);
        else if (id === "TP1") out.artist = decodeText(buf, d, sz);
        else if (id === "PIC") out.cover = parseApic(buf, d, sz, true);
        off = d + sz;
      }
    } else {
      // ID3v2.3/v2.4：4 字节帧 ID
      while (off + 10 <= end) {
        const id = String.fromCharCode(buf[off], buf[off + 1], buf[off + 2], buf[off + 3]);
        const sz = ver === 4 ? readSyncsafe(buf, off + 4, 4) : buf.readUInt32BE(off + 4);
        const d = off + 10;
        if (sz <= 0 || d + sz > buf.length) break;
        if (id === "TIT2") out.title = decodeText(buf, d, sz);
        else if (id === "TPE1") out.artist = decodeText(buf, d, sz);
        else if (id === "APIC") out.cover = parseApic(buf, d, sz, false);
        off = d + sz;
      }
    }
  }

  function parseApic(buf, off, sz, v22) {
    // encoding(1) + [MIME(v23+: null结尾) / imageformat(3, v22)] + [type(1)] + [desc(null结尾)] + data
    try {
      let p = off + 1;
      let mime;
      if (v22) {
        mime = String.fromCharCode(buf[p], buf[p + 1], buf[p + 2]).toLowerCase();
        p += 3;
      } else {
        let e = p;
        while (e < off + sz && buf[e] !== 0) e++;
        mime = String.fromCharCode.apply(null, buf.slice(p, e)).toLowerCase();
        p = e + 1;
      }
      p += 1; // picture type
      // description（null 结尾，注意 encoding 可能为 UTF-16）
      while (p < off + sz && buf[p] !== 0) p++;
      p += 1;
      if (buf[p] === 0) p += 1; // UTF-16 双字节 null
      const data = buf.slice(p, off + sz);
      if (data.length > 0) return data;
    } catch (e) { /* 忽略 */ }
    return null;
  }

  function decodeText(buf, off, sz) {
    try {
      const enc = buf[off];
      let p = off + 1;
      if (enc === 1 || enc === 2) { // UTF-16
        // 可能有 BOM
        let bytes = buf.slice(p, off + sz);
        // 去掉末尾 null
        while (bytes.length && bytes[bytes.length - 1] === 0) bytes = bytes.subarray(0, bytes.length - 1);
        return new TextDecoder("utf-16le").decode(bytes).replace(/\0/g, "").trim();
      }
      if (enc === 3) { // UTF-8
        return new TextDecoder("utf-8").decode(buf.slice(p, off + sz)).replace(/\0/g, "").trim();
      }
      // ISO-8859-1
      return new TextDecoder("iso-8859-1").decode(buf.slice(p, off + sz)).replace(/\0/g, "").trim();
    } catch (e) {
      return "";
    }
  }

  function readSyncsafe(buf, off, len) {
    let v = 0;
    for (let i = 0; i < len; i++) v = (v << 7) | (buf[off + i] & 0x7f);
    return v;
  }

  // FLAC：解析 PICTURE 块（type=6）拿封面，VORBIS_COMMENT（type=4）拿标题/歌手
  function parseFlac(buf, out) {
    let off = 4; // 跳过 "fLaC"
    let last = false;
    while (off + 4 <= buf.length && !last) {
      const header = buf.readUInt32BE(off);
      last = (header & 0x80000000) !== 0;
      const type = (header >> 24) & 0x7f;
      const size = header & 0x00ffffff;
      off += 4;
      if (off + size > buf.length) break;
      if (type === 6) { // PICTURE
        try {
          let p = off + 4; // picture type
          const mimeLen = buf.readUInt32BE(p); p += 4;
          p += mimeLen; // mime
          const descLen = buf.readUInt32BE(p); p += 4;
          p += descLen; // description
          p += 16; // width/height/depth/colors
          const dataLen = buf.readUInt32BE(p); p += 4;
          if (dataLen > 0 && p + dataLen <= buf.length) out.cover = buf.slice(p, p + dataLen);
        } catch (e) { /* 忽略 */ }
      } else if (type === 4) { // VORBIS_COMMENT
        try {
          let p = off + 4; // vendor length
          const vendorLen = buf.readUInt32LE(p); p += 4 + vendorLen;
          const count = buf.readUInt32LE(p); p += 4;
          for (let i = 0; i < Math.min(count, 50); i++) {
            const clen = buf.readUInt32LE(p); p += 4;
            const s = new TextDecoder("utf-8").decode(buf.slice(p, p + clen));
            p += clen;
            const eq = s.indexOf("=");
            if (eq > 0) {
              const k = s.slice(0, eq).toUpperCase();
              const v = s.slice(eq + 1);
              if (k === "TITLE" && !out.title) out.title = v;
              else if (k === "ARTIST" && !out.artist) out.artist = v;
            }
          }
        } catch (e) { /* 忽略 */ }
      }
      off += size;
    }
  }

  // ============ 底部频谱条（Web Audio 实时分析）============
  const eqCanvas = $("eq-canvas");
  const eqCtx = eqCanvas.getContext("2d");
  let analyser = null;
  let audioCtx = null;
  let eqRaf = null;

  // 创建 AudioContext + AnalyserNode（必须由用户手势触发后调用，否则浏览器阻塞）
  let spectrumAttempted = false;
  function initSpectrum() {
    if (analyser || spectrumAttempted) return;
    spectrumAttempted = true;
    try {
      const AC = window.AudioContext || window.webkitAudioContext;
      if (!AC) return;
      audioCtx = new AC();
      // 把 <audio> 接到分析器（MediaElementSource 只能创建一次）
      const src = audioCtx.createMediaElementSource(audio);
      analyser = audioCtx.createAnalyser();
      analyser.fftSize = 512;             // 256 个频点
      analyser.smoothingTimeConstant = 0.82; // 平滑，跳动流畅
      src.connect(analyser);
      analyser.connect(audioCtx.destination);
      sizeEqCanvas();
      window.addEventListener("resize", sizeEqCanvas);
      drawEq();
    } catch (e) { /* 不支持则静默降级 */ }
  }

  function sizeEqCanvas() {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    eqCanvas.width = Math.floor(window.innerWidth * dpr);
    eqCanvas.height = Math.floor(110 * dpr);
  }

  // 绘制：上百根细柱，中间高两侧低（对称拱形），半透明白
  function drawEq() {
    eqRaf = requestAnimationFrame(drawEq);
    if (!analyser) return;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const W = eqCanvas.width, H = eqCanvas.height;
    eqCtx.clearRect(0, 0, W, H);

    const data = new Uint8Array(analyser.frequencyBinCount); // 256
    analyser.getByteFrequencyData(data);

    const N = 160;                       // 柱子数量
    const barW = W / N;
    const gap = barW * 0.25;             // 柱间空隙
    const barX = Math.max(1, barW - gap);

    for (let i = 0; i < N; i++) {
      // 拱形权重：中间=1，两端=0.25（"中间高、两侧低"）
      const arch = 0.25 + 0.75 * Math.pow(Math.sin((i / (N - 1)) * Math.PI), 1.1);
      // 对数频率采样：低频占更多柱（视觉上低音更明显，人声/鼓点位置柱同步升高）
      const t = i / N;
      const binIdx = Math.min(data.length - 1, Math.floor(Math.pow(t, 1.5) * (data.length - 1)));
      const v = data[binIdx] / 255;
      // 高度：拱形权重 × 音量 × 基础幅度（柔和不刺眼）
      const h = Math.max(2, v * arch * H * 0.92);
      const x = i * barW + gap / 2;
      eqCtx.fillStyle = "rgba(255,255,255,0.38)";
      eqCtx.fillRect(x, H - h * dpr, barX * dpr, h * dpr);
      // 柱顶加一点更亮的高光，增强"跳动"质感
      eqCtx.fillStyle = "rgba(255,255,255,0.55)";
      eqCtx.fillRect(x, H - h * dpr, barX * dpr, Math.max(1, 3 * dpr));
    }
  }

  // ============ 播放控制 ============
  function playAt(idx) {
    if (idx < 0 || idx >= songs.length) return;
    currentIdx = idx;
    const song = songs[idx];
    // 首次播放时初始化频谱（须在用户手势内创建 AudioContext）
    initSpectrum();
    if (audioCtx && audioCtx.state === "suspended") audioCtx.resume().catch(() => {});
    audio.src = song.url;
    audio.play().then(() => {
      playing = true;
      updatePlayIcon();
    }).catch(() => { /* 自动播放限制等 */ });
    lastLyricIdx = -1;   // 重置行索引，确保新歌第一句正常渲染
    updateNowPlaying();
    renderPlaylist();
  }

  // 歌名/歌手：同行滚动（超长才滚动，否则静态显示；不用省略号）
  function setMarquee(container, text) {
    // 把文本放进内部滚动 span（先清掉容器原有文本节点，避免新旧内容叠加）
    let inner = container.querySelector(".marquee-inner");
    if (!inner) {
      while (container.firstChild) container.removeChild(container.firstChild);
      inner = document.createElement("span");
      inner.className = "marquee-inner";
      container.appendChild(inner);
    }
    inner.textContent = text;

    // 等布局后判断是否溢出
    requestAnimationFrame(() => {
      const avail = container.clientWidth;
      const full = inner.scrollWidth;
      if (full > avail) {
        // 居中容器在超宽时两侧都会被裁剪 → 滚动时临时切左对齐，从左侧开始滚
        container.style.textAlign = "left";
        const dist = avail - full - 80;   // 负向位移，含尾部 80px 间隔一起滚出
        inner.style.setProperty("--scroll-dist", dist + "px");
        // 滚动时长与长度成正比：约 40px/s，最少 8s 最多 24s
        const dur = Math.min(24, Math.max(8, Math.abs(dist) / 40));
        inner.style.setProperty("--scroll-dur", dur + "s");
        inner.classList.remove("static");
        // 强制重启动画（切歌时重新开始）
        inner.style.animation = "none";
        void inner.offsetWidth;
        inner.style.animation = "";
      } else {
        inner.classList.add("static");
        container.style.textAlign = "";
      }
    });
  }

  function updateNowPlaying() {
    const song = songs[currentIdx];
    if (!song) return;
    setMarquee(mainTitle, song.name);
    setMarquee(subTitle, song.artist);
    if (song.cover) {
      coverImg.src = song.cover;
      coverImg.classList.add("show");
      cover.classList.add("has-cover");
      bg.classList.add("has-cover");
    } else {
      coverImg.classList.remove("show");
      cover.classList.remove("has-cover");
      bg.classList.remove("has-cover");
    }
    // 歌词
    const lines = song.lrc ? parseLrc(song.lrc) : [];
    song._lines = lines;
    if (!lines.length) {
      lrcPrev.textContent = "";
      lrcCurrent.textContent = "暂无歌词";
      lrcCurrent.className = "lyric-line current lyric-placeholder";
      lrcNext.textContent = "";
    } else {
      lrcCurrent.className = "lyric-line current";
    }
  }

  // LRC 解析（支持行内翻译 `原文 (翻译)` 或 `原文（翻译）`）
  // 返回 [{ time, text, trans }]：trans 可为空字符串
  function parseLrc(text) {
    const lines = [];
    const re = /\[(\d{1,2}):(\d{1,2})(?:[.:](\d{1,3}))?\]/g;
    const body = text.replace(/^\uFEFF/, "");
    for (const raw of body.split(/\r?\n/)) {
      re.lastIndex = 0;
      let m;
      const tags = [];
      while ((m = re.exec(raw)) !== null) {
        const min = parseInt(m[1]);
        const sec = parseInt(m[2]);
        let ms = parseInt(m[3] || "0");
        if (m[3] && m[3].length === 2) ms *= 10;
        else if (m[3] && m[3].length === 1) ms *= 100;
        tags.push(min * 60000 + sec * 1000 + ms);
      }
      if (tags.length === 0) continue;
      let content = raw.replace(re, "").trim();
      if (!content) continue;
      // 拆行内翻译：行尾 `(xxx)` / `（xxx）`，且括号前含英文/日文假名才认为是翻译
      let trans = "";
      const m2 = content.match(/[（(]([^（）()]*)[）)]\s*$/);
      if (m2) {
        const before = content.slice(0, m2.index).trim();
        const hasForeign = /[A-Za-z\u3040-\u30ff]/.test(before);
        if (hasForeign && before) {
          content = before;
          trans = m2[1].trim();
        }
      }
      for (const t of tags) lines.push({ time: t, text: content, trans });
    }
    lines.sort((a, b) => a.time - b.time);
    return lines;
  }

  // 进度同步（歌词行切换与扫光由 scanLoop rAF 统一驱动，此处只负责进度条/时间）
  audio.addEventListener("timeupdate", () => {
    const t = audio.currentTime;
    const d = audio.duration || 0;
    const pct = d ? (t / d) * 100 : 0;
    progressFill.style.width = pct + "%";
    progressDot.style.left = pct + "%";
    timeCurrent.textContent = fmtTime(t);
    timeTotal.textContent = fmtTime(d);
  });

  function syncLyrics(ms) {
    const song = songs[currentIdx];
    if (!song || !song._lines || !song._lines.length) return;
    const lines = song._lines;
    let cur = -1;
    for (let i = 0; i < lines.length; i++) {
      if (lines[i].time <= ms) cur = i;
      else break;
    }
    if (cur === -1) cur = 0;
    const last = cur === lines.length - 1 || (cur >= 0 && cur + 1 >= lines.length);
    // 上/下句：只显示原文（保持三行简洁）；当前句：原文 + 翻译
    setLine(lrcPrev, cur > 0 ? lines[cur - 1] : null, false);
    setLine(lrcCurrent, lines[cur], true);
    setLine(lrcNext, last ? null : lines[cur + 1], false);
    lrcCurrent.className = "lyric-line current";
  }

  // 渲染一行歌词：line 为 {text, trans}；showTrans 控制是否显示翻译
  // 当前句始终保留 .lyric-main 结构（卡拉OK扫光依赖该结构）
  function setLine(el, line, showTrans) {
    if (!line) { el.textContent = ""; return; }
    el.innerHTML = "";
    const main = document.createElement("span");
    main.className = "lyric-main";
    main.textContent = line.text;
    el.appendChild(main);
    if (showTrans && line.trans) {
      const trans = document.createElement("span");
      trans.className = "lyric-trans";
      trans.textContent = line.trans;
      el.appendChild(trans);
    }
  }

  // 卡拉OK扫光 + 行切换统一驱动（同一 rAF 循环，帧级同步，避免行边界闪"小头"）
  // ⚠️ 之前扫光(rAF)与行切换(timeupdate)分开算 cur，行边界时扫光先于文本切换
  //    导致上一句文本带着下一句的扫光进度闪一下 → 现在统一由本循环驱动
  let lastLyricIdx = -1;
  function scanLoop() {
    requestAnimationFrame(scanLoop);
    const song = songs[currentIdx];
    if (!song || !song._lines || !song._lines.length) return;
    const lines = song._lines;
    const ms = audio.currentTime * 1000;

    // 计算当前行
    let cur = -1;
    for (let i = 0; i < lines.length; i++) {
      if (lines[i].time <= ms) cur = i;
      else break;
    }
    if (cur === -1) cur = 0;

    // 行变化时才刷新文本（同一行内只更新扫光进度，不重复渲染 DOM）
    if (cur !== lastLyricIdx) {
      lastLyricIdx = cur;
      const last = cur === lines.length - 1;
      setLine(lrcPrev, cur > 0 ? lines[cur - 1] : null, false);
      setLine(lrcCurrent, lines[cur], true);
      setLine(lrcNext, last ? null : lines[cur + 1], false);
      lrcCurrent.className = "lyric-line current";
    }

    // 扫光进度：当前行内已播比例 0→100%
    const start = lines[cur].time;
    const end = cur + 1 < lines.length ? lines[cur + 1].time : start + 6000;
    const p = Math.max(0, Math.min(1, (ms - start) / (end - start)));
    lrcCurrent.style.setProperty("--scan-p", (p * 100).toFixed(1) + "%");
  }
  scanLoop();

  function fmtTime(sec) {
    if (!isFinite(sec) || sec < 0) return "0:00";
    sec = Math.floor(sec);
    const m = Math.floor(sec / 60);
    const s = sec % 60;
    return m + ":" + (s < 10 ? "0" : "") + s;
  }

  // 播放/暂停
  btnPlay.addEventListener("click", () => {
    if (currentIdx < 0) { showFeedback("请先点击 ⋮ 菜单选择音乐文件夹"); return; }
    initSpectrum();
    if (audioCtx && audioCtx.state === "suspended") audioCtx.resume().catch(() => {});
    if (audio.paused) {
      audio.play().then(() => { playing = true; updatePlayIcon(); }).catch(() => {});
    } else {
      audio.pause();
      playing = false;
      updatePlayIcon();
    }
  });

  function updatePlayIcon() {
    iconPlay.style.display = playing ? "none" : "";
    iconPause.style.display = playing ? "" : "none";
  }

  // 上一曲 / 下一曲
  btnPrev.addEventListener("click", () => {
    if (!songs.length) return;
    if (audio.currentTime > 3) { audio.currentTime = 0; return; } // 已播超3s则回到开头
    let idx;
    if (modeIdx === 1 && songs.length > 1) {
      do { idx = Math.floor(Math.random() * songs.length); } while (idx === currentIdx);
    } else {
      idx = (currentIdx - 1 + songs.length) % songs.length;
    }
    playAt(idx);
  });

  btnNext.addEventListener("click", () => {
    if (!songs.length) return;
    let idx;
    if (modeIdx === 1 && songs.length > 1) {
      do { idx = Math.floor(Math.random() * songs.length); } while (idx === currentIdx);
    } else {
      idx = (currentIdx + 1) % songs.length;
    }
    playAt(idx);
  });

  audio.addEventListener("ended", () => {
    if (modeIdx === 2) { // 单曲循环
      audio.currentTime = 0;
      audio.play().catch(() => {});
      return;
    }
    btnNext.click();
  });

  // 播放模式切换
  btnMode.addEventListener("click", () => {
    modeIdx = (modeIdx + 1) % modeOrder.length;
    const key = modeOrder[modeIdx];
    for (const [k, v] of Object.entries(modeIcons)) v.style.display = k === key ? "" : "none";
    btnMode.title = "播放模式：" + modeNames[key];
  });

  // 进度条交互
  progressEl.addEventListener("mousedown", (e) => {
    seekFromEvent(e);
    const move = (ev) => seekFromEvent(ev);
    const up = () => { window.removeEventListener("mousemove", move); window.removeEventListener("mouseup", up); };
    window.addEventListener("mousemove", move);
    window.addEventListener("mouseup", up);
  });
  function seekFromEvent(e) {
    if (!audio.duration) return;
    const rect = progressEl.getBoundingClientRect();
    const ratio = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
    audio.currentTime = ratio * audio.duration;
    const pct = ratio * 100;
    progressFill.style.width = pct + "%";
    progressDot.style.left = pct + "%";
  }

  // ============ 更多菜单 / 播放列表 ============
  btnMore.addEventListener("click", (e) => {
    e.stopPropagation();
    moreMenu.classList.toggle("open");
    playlistPanel.classList.remove("open");
  });
  document.addEventListener("click", () => {
    moreMenu.classList.remove("open");
    playlistPanel.classList.remove("open");
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") { moreMenu.classList.remove("open"); playlistPanel.classList.remove("open"); }
  });
  $("menu-playlist").addEventListener("click", (e) => {
    e.stopPropagation();
    moreMenu.classList.remove("open");
    playlistPanel.classList.toggle("open");
  });

  function renderPlaylist() {
    plList.innerHTML = "";
    if (!songs.length) {
      plList.innerHTML = '<div class="pl-empty">还没有加载本地音乐，点击「选择音乐文件夹」</div>';
      return;
    }
    songs.forEach((s, i) => {
      const item = document.createElement("div");
      item.className = "pl-item" + (i === currentIdx ? " active" : "");
      item.innerHTML =
        '<span class="pl-idx">' + (i + 1) + '</span>' +
        '<span class="pl-name"></span>' +
        '<span class="pl-artist"></span>';
      item.querySelector(".pl-name").textContent = s.name;
      item.querySelector(".pl-artist").textContent = s.artist;
      item.addEventListener("click", () => playAt(i));
      plList.appendChild(item);
    });
  }

  // ============ 顶部搜索（占位）============
  $("search-hint").addEventListener("click", () => {
    const kw = $("search-input").value.trim();
    showFeedback(kw ? "演示版：在线搜索「" + kw + "」（正式版接入）" : "请在顶部输入歌名搜索");
  });
  $("search-input").addEventListener("keydown", (e) => {
    if (e.key === "Enter") $("search-hint").click();
  });

  // ============ 反馈提示 ============
  let tipTimer;
  function showFeedback(text) {
    const tip = $("feedback-tip");
    tip.textContent = text;
    tip.style.opacity = "1";
    clearTimeout(tipTimer);
    tipTimer = setTimeout(() => { tip.style.opacity = "0"; }, 1500);
  }

  // ============ 底部励志句轮换 ============
  const motivationEl = $("motivation");

  // 初始标题走 marquee 结构（默认短文本，静态显示；选中歌曲后由 updateNowPlaying 更新）
  setMarquee(mainTitle, mainTitle.textContent.trim());
  setMarquee(subTitle, subTitle.textContent.trim());

  const quotes = [
    "把平凡的日子，过成滚烫的诗",
    "音乐响起的地方，就是诗和远方",
    "生活不止眼前的苟且，还有歌和星光",
    "所有的美好，都藏在下一次播放里",
    "愿你眼里有光，心中有歌，脚下有风",
    "慢慢来，比较快",
  ];
  let qi = 0;
  setInterval(() => {
    motivationEl.classList.add("fade");
    setTimeout(() => {
      qi = (qi + 1) % quotes.length;
      motivationEl.textContent = quotes[qi];
      motivationEl.classList.remove("fade");
    }, 600);
  }, 6000);
})();
</script>
</body>
</html>
